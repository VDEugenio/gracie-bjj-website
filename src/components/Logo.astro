---
/**
 * The Relson Gracie badge (350px PNG source), sized by CSS: size-14 for the
 * phone header, size-15 desktop, size-18 and size-24 in the footers. Output at
 * 192px WebP, twice the largest size shown. Swap the import for an SVG if a
 * vector arrives.
 */
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';

interface Props {
  class?: string;
  /** Decorative when the parent link already has a label. */
  decorative?: boolean;
}

const { class: className = 'size-14', decorative = false } = Astro.props;
---

<Image
  src={logo}
  width={192}
  height={192}
  format="webp"
  alt={decorative ? '' : 'Relson Gracie badge'}
  class:list={['rounded-full', className]}
  loading="eager"
  decoding="async"
/>
