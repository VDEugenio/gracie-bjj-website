---
/**
 * Fighter-style coach card.
 * - full (coaches page): a card that flips. The front is the 4:5 portrait under
 *   a scrim with the rank set vertically top-right, role and stacked name over
 *   the bottom, the belt stripe and a "Read bio" cue. The back holds the
 *   specialties, bio and the "Teaches" line over the same portrait, mirrored
 *   (as if seen through the card) and darkened so the text reads. Without JavaScript the back simply
 *   reads below the front (src/scripts/coach-flip.ts turns the flip on).
 * - compact (home): photo, name, belt stripe and rank, linking to /coaches.
 * The desktop tilt, the flip turn and the belt tie-on live in src/lib/motion.ts.
 */
import { RotateCcw, RotateCw } from 'lucide-astro';
import BeltStripe from './BeltStripe.astro';
import Photo from './Photo.astro';
import Tag from './Tag.astro';
import { beltLabel, rankLine } from '@/lib/belts';
import type { Coach } from '@/lib/content';
import { firstRole, splitName } from '@/lib/format';

interface Props {
  coach: Coach;
  variant?: 'full' | 'compact';
  headingLevel?: 2 | 3;
  class?: string;
}

const { coach, variant = 'full', headingLevel = 2, class: className } = Astro.props;
const { data } = coach;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const { first, last } = splitName(data.name);
const headingId = `coach-${variant}-${coach.id}`;
const backId = `coach-bio-${coach.id}`;
const rank = rankLine(data);
const alt = `Portrait of ${data.name}`;
const photoProps = { position: data.photoPosition, widths: [360, 480, 720], sizes: '(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw' };
const face = 'relative flex flex-col overflow-hidden rounded-sm border border-line bg-surface-raised transition-colors group-hover:border-ink';
const cue = 'flex w-full cursor-pointer items-center justify-between gap-3 px-5 py-3.5 text-label uppercase text-ink-muted transition-colors group-hover:text-ink';
---

{
  variant === 'full' ? (
    <article
      class:list={['group relative flex flex-col', className]}
      aria-labelledby={headingId}
      data-motion="coach-card"
      data-tilt
      data-coach-flip
    >
      <div class="flex flex-1 flex-col" data-flip-inner>
        <div class={face} data-flip-face="front">
          <div class="relative aspect-4/5 w-full flex-1 overflow-hidden bg-surface-muted" data-tilt-photo>
            {data.photo ? (
              <Photo image={data.photo} alt={alt} {...photoProps} />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center p-4 text-center font-mono text-time-sm text-ink-muted">
                4:5 portrait · {data.name}
              </div>
            )}
            <div class="absolute inset-0 scrim-card" aria-hidden="true" />
            <span class="absolute right-3.5 top-3.5 bg-surface/80 px-1 py-2.5 text-label-xs uppercase text-ink [writing-mode:vertical-rl]">{rank}</span>
            <div class="absolute bottom-5.5 left-5 right-13 flex flex-col gap-2.5">
              <span class="text-label uppercase text-ink">{data.role}</span>
              <Heading id={headingId} class="display text-display-name text-ink">
                {first}
                {last && (
                  <>
                    <br />
                    {last}
                  </>
                )}
              </Heading>
            </div>
          </div>
          <BeltStripe belt={data.belt} />
          <button type="button" class={cue} aria-expanded="false" aria-controls={backId} data-flip-cue data-flip-toggle>
            <span>
              Read bio<span class="sr-only"> of {data.name}</span>
            </span>
            <RotateCw size={16} stroke-width={1.5} aria-hidden="true" />
          </button>
        </div>
        <div id={backId} class={face} data-flip-face="back">
          {data.photo && (
            <div class="absolute inset-0" aria-hidden="true">
              <Photo image={data.photo} alt="" {...photoProps} class="-scale-x-100" />
              <div class="absolute inset-0 bg-surface/80" />
            </div>
          )}
          <div class="relative flex flex-1 flex-col gap-3 p-5 pb-6">
            <p class="text-label uppercase text-ink" aria-hidden="true">
              {data.name} · {beltLabel(data.belt)}
            </p>
            {data.specialties.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {data.specialties.map((s) => (
                  <Tag>{s}</Tag>
                ))}
              </div>
            )}
            <p class="text-body-sm leading-relaxed text-ink">{data.bio}</p>
            <div class="mt-auto flex justify-between gap-3 border-t border-line pt-3">
              <span class="pt-0.75 text-label uppercase text-ink-muted">{data.teachesLabel ?? 'Teaches'}</span>
              <span class="text-right font-mono text-time text-ink">{data.teaches}</span>
            </div>
          </div>
          <button type="button" class:list={[cue, 'relative border-t border-line']} data-flip-cue data-flip-toggle>
            <span>
              Back<span class="sr-only"> to {data.name}'s portrait</span>
            </span>
            <RotateCcw size={16} stroke-width={1.5} aria-hidden="true" />
          </button>
        </div>
      </div>
    </article>
  ) : (
    <a
      href="/coaches"
      class:list={[
        'group relative flex flex-col overflow-hidden rounded-sm border border-line bg-surface-raised text-ink no-underline transition-colors hover:border-ink',
        className,
      ]}
      aria-labelledby={headingId}
      data-motion="coach-card"
      data-tilt
    >
      <div class="relative aspect-4/5 overflow-hidden bg-surface-muted" data-tilt-photo>
        {data.photo ? (
          <Photo image={data.photo} alt={alt} position={data.photoPosition} widths={[240, 360, 480]} sizes="(min-width: 768px) 33vw, 50vw" />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center p-4 text-center font-mono text-time-sm text-ink-muted">
            4:5 portrait · {data.name}
          </div>
        )}
        <div class="absolute inset-0 scrim-card" aria-hidden="true" />
        <div class="absolute bottom-3.5 left-3 right-3 flex flex-col gap-1.5">
          <span class="text-label-xs uppercase text-ink md:text-label-sm">{firstRole(data.role)}</span>
          <Heading id={headingId} class="display text-display-name-sm text-ink">
            {first}
            {last && (
              <>
                <br />
                {last}
              </>
            )}
          </Heading>
        </div>
      </div>
      <BeltStripe belt={data.belt} size="sm" />
      <div class="flex flex-col gap-2.5 p-3 md:px-5 md:pb-5 md:pt-4">
        <span class="text-label-xs uppercase text-ink-muted md:text-label">
          <span class="md:hidden">{beltLabel(data.belt)}</span>
          <span class="hidden md:inline">{rank}</span>
        </span>
        {data.specialties.length > 0 && (
          <div class="hidden flex-wrap gap-2 md:flex">
            {data.specialties.map((s) => (
              <Tag>{s}</Tag>
            ))}
          </div>
        )}
      </div>
    </a>
  )
}

<script>
  import '@/scripts/coach-flip';
</script>
