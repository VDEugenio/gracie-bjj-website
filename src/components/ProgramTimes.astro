---
/**
 * Day / time rows in mono, e.g. "Mon  12:00 PM · 7:00 PM". Rows come from
 * timeRows() so consecutive days with the same times collapse ("Mon–Thu").
 */
import type { TimeRow } from '@/lib/schedule';

interface Props {
  rows: TimeRow[];
  class?: string;
}

const { rows, class: className } = Astro.props;
---

{
  rows.length > 0 && (
    <dl
      class:list={[
        'mt-1 grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1.5 border-t border-line pt-3 font-mono text-time-sm md:mt-2 md:gap-x-4 md:gap-y-2 md:pt-4 md:text-time',
        className,
      ]}
    >
      {rows.map((row) => (
        <>
          <dt class="w-14 text-ink-muted md:w-18">{row.days}</dt>
          <dd class="m-0 text-ink">{row.times}</dd>
        </>
      ))}
    </dl>
  )
}
