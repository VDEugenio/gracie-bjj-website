---
/**
 * One day of the schedule as a card: day name, then a hairline row per class
 * (mono time, program). Today's card gets the signal top edge and
 * a "Today" label through the data-today attribute, which the today script
 * (src/scripts/today.ts) sets client-side; the `today` prop forces it for previews.
 *
 * Rows carry data attributes the schedule filter reads.
 */
import type { DayClasses } from '@/lib/schedule';

interface Props {
  day: DayClasses;
  today?: boolean;
  /** `home` is the "Today at the gym" card: page surface, class count instead of the Today label. */
  variant?: 'card' | 'home';
  headingLevel?: 2 | 3;
  /** Footnote pinned to the bottom of the card (the Saturday card carries the schedule note). */
  note?: string;
  /** Classes for the footnote, e.g. "hidden md:block" when phones show the note elsewhere. */
  noteClass?: string;
  /** Heading id override, needed when the same day renders twice on a page. */
  id?: string;
  class?: string;
}

const { day, today = false, variant = 'card', headingLevel = 2, note, noteClass, id, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const headingId = id ?? `day-${variant}-${day.key}`;
const count = day.classes.length;
---

<section
  class:list={[
    'group flex flex-col rounded-sm border border-line p-6 data-today:border-t-2 data-today:border-t-signal',
    variant === 'home' ? 'bg-surface md:p-8' : 'bg-surface-raised',
    className,
  ]}
  aria-labelledby={headingId}
  data-schedule-day
  data-day={day.key}
  data-today={today || undefined}
  data-motion="reveal"
>
  <Heading id={headingId} class="title text-title mb-3 flex items-baseline justify-between gap-3 text-ink">
    {day.label}
    {
      variant === 'home' ? (
        <span class="font-mono text-time text-ink-muted">
          <span data-today-date></span>
          {count} {count === 1 ? 'class' : 'classes'}
        </span>
      ) : (
        <span class="hidden text-label uppercase text-signal-text group-data-today:inline">Today</span>
      )
    }
  </Heading>

  <div class="flex flex-col" data-rows>
    {
      day.classes.map((c) => (
        <div
          class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3 border-t border-line py-3"
          data-class-row
          data-audience={c.program.data.audience}
          data-start-here={c.program.data.startHere ? 'true' : 'false'}
          data-program={c.program.id}
        >
          <span class="w-22 font-mono text-time text-ink-muted">{c.time}</span>
          <span class="font-medium text-ink">{c.program.data.name}</span>
        </div>
      ))
    }
    {count === 0 && <p class="border-t border-line py-3 text-caption text-ink-muted">No classes.</p>}
  </div>
  <p class="border-t border-line py-3 text-caption text-ink-muted" data-empty-note hidden>
    Nothing on this day for that filter.
  </p>

  {note && <p class:list={['mt-auto pt-6 text-caption text-ink-muted', noteClass]}>{note}</p>}
</section>
