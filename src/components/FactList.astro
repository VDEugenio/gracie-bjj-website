---
/**
 * The facts strip on a program page: When / Length / Who / Cost.
 * A hairline list on phones, four columns on desktop. Mono for times.
 */
interface Props {
  facts: Array<{ label: string; value: string; mono?: boolean }>;
  class?: string;
}

const { facts, class: className } = Astro.props;
---

<dl class:list={['m-0 border-t border-line md:grid md:grid-cols-4 md:gap-8 md:border-0', className]}>
  {
    facts.map((fact) => (
      <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-3 border-b border-line py-3 md:flex md:flex-col md:gap-2 md:border-b-0 md:border-t md:pb-0 md:pt-4">
        <dt class="w-18 pt-1 text-label uppercase text-ink-muted md:w-auto md:pt-0">{fact.label}</dt>
        <dd class:list={['m-0 text-ink', fact.mono ? 'font-mono text-time md:text-time-l' : 'text-body-sm md:text-body']}>{fact.value}</dd>
      </div>
    ))
  }
</dl>
