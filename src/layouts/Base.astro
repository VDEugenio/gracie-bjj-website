---
/**
 * Base layout: <head>, SEO basics, promo banner, header, the page, footer,
 * and the one-time motion start (src/lib/motion.ts).
 *
 * SEO: every page passes a unique title and description. Open Graph and
 * Twitter tags share one photo (the team shot, cropped to 1200×630 at build
 * time), and the LocalBusiness JSON-LD comes from settings plus the schedule
 * (src/lib/seo.ts). Canonical and OG URLs use SITE_URL (astro.config.mjs).
 */
import '@/styles/global.css';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import PromoBanner from '@/components/PromoBanner.astro';
import { getPromo, getSchedule, getSettings } from '@/lib/content';
import { getImage } from 'astro:assets';
import { gymdeskUrl } from '@/lib/gymdesk';
import { localBusiness } from '@/lib/seo';
import ogPhoto from '@/assets/sections/team-group-photo.jpg';
import logo from '@/assets/logo-placeholder.webp';
// The two fonts every page paints first (headlines and body text). Preloading
// them saves a round trip and keeps the font swap from shifting the layout.
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

export interface Props {
  /** Unique page title. The gym name is appended automatically. */
  title: string;
  /** Unique meta description, about 150 characters. */
  description: string;
  /** Page slug used for utm_campaign on Gymdesk links, e.g. "home", "schedule", "program-fundamentals". */
  campaign: string;
  /** Path used for canonical URLs and aria-current, e.g. "/schedule". Defaults to the current URL. */
  currentPath?: string;
  /** Keep dev-only pages out of search results. */
  noindex?: boolean;
}

const { title, description, campaign, currentPath = Astro.url.pathname, noindex = false } = Astro.props;

const [settings, promo, schedule] = await Promise.all([getSettings(), getPromo(), getSchedule()]);

const siteName = settings.name;
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(currentPath, Astro.site ?? Astro.url).href;
const promoHref = promo?.linkUrl ? gymdeskUrl(promo.linkUrl, campaign, 'promo') : undefined;

const site = Astro.site ?? Astro.url;
const OG = { width: 1200, height: 630 };
const og = await getImage({ src: ogPhoto, ...OG, fit: 'cover', position: 'center', format: 'jpg', quality: 80 });
const ogImage = new URL(og.src, site).href;
const ogAlt = `The team at ${siteName} on the mats after class`;
const jsonLd = localBusiness({ settings, schedule, site, image: ogImage, logo: new URL(logo.src, site).href });
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#121212" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG.width)} />
    <meta property="og:image:height" content={String(OG.height)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="bg-surface font-body text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-sm focus:bg-signal focus:px-4 focus:py-3 focus:text-button focus:uppercase focus:text-on-signal"
    >
      Skip to content
    </a>
    <PromoBanner promo={promo} href={promoHref} />
    <Header settings={settings} currentPath={currentPath} campaign={campaign} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer settings={settings} schedule={schedule} currentPath={currentPath} campaign={campaign} />
    <script>
      import '@/scripts/today';
      import { initMotion } from '@/lib/motion';

      initMotion();
    </script>
  </body>
</html>
