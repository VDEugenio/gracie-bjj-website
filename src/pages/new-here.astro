---
/**
 * "New to BJJ?": what a first-timer needs to know before their first class.
 * No mockup. A dark hero with the title and buttons on the left and the topics
 * as one-at-a-time dropdowns on the right (stacked on phones), then the facts
 * strip and the closing call to action over the welcome photo. Times and
 * prices come from the content collections.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Disclosure from '@/components/Disclosure.astro';
import FactList from '@/components/FactList.astro';
import FinalCta from '@/components/FinalCta.astro';
import Tag from '@/components/Tag.astro';
import { getPricing, getPrograms, getSchedule, getSettings } from '@/lib/content';
import { fitStyle } from '@/lib/fit';
import { padIndex, telHref } from '@/lib/format';
import { gymdeskUrl } from '@/lib/gymdesk';
import { DAYS, summaryFor } from '@/lib/schedule';
import welcomePhoto from '@/assets/sections/welcome.jpg';

const campaign = 'new-here';
const [settings, programs, schedule, pricing] = await Promise.all([getSettings(), getPrograms(), getSchedule(), getPricing()]);
const signup = (placement: Parameters<typeof gymdeskUrl>[2]) => gymdeskUrl(settings.gymdesk.signupUrl, campaign, placement);

const activeDays = DAYS.filter((d) => schedule.some((c) => c.data.day === d.key));
const firstDay = activeDays[0]?.label ?? 'Monday';
const lastDay = activeDays[activeDays.length - 1]?.label ?? 'Saturday';
const monthly = pricing.find((p) => p.data.period === 'month');
const starters = programs.filter((p) => p.data.startHere);
const youth = programs.find((p) => p.data.audience === 'kids');

const facts = [
  { label: 'Cost', value: 'First week free' },
  { label: 'Classes', value: `${firstDay} to ${lastDay}` },
  { label: 'Who', value: 'Adults and kids, all levels' },
  ...(monthly ? [{ label: 'After that', value: `${monthly.data.price}/month`, mono: true }] : []),
];

const firstWeek = [
  { title: 'No experience needed', note: 'Every class has first-timers. Coaches walk you through everything.' },
  { title: 'Wear a rash guard and shorts', note: "Wear what you'd wear to any gym. We train No-Gi only." },
  { title: 'Your first week is free', note: 'Try any class for seven days before you decide.' },
];

const classParts = [
  { title: 'Warm-up', note: 'Movement drills that get you used to moving on the mat.' },
  { title: 'Technique', note: 'The coach shows one position or move, step by step.' },
  { title: 'Drilling', note: 'You practise it with a partner, slowly, taking turns.' },
  { title: 'Rolling', note: 'Live rounds with a partner. You can tap at any time, and the round stops.' },
];

const wear = [
  { title: 'A rash guard or fitted T-shirt', note: "Something snug that won't ride up or catch fingers." },
  { title: 'Athletic shorts', note: 'No pockets, zippers or belt loops. Spats or leggings underneath are fine.' },
  { title: 'Bare feet on the mat', note: 'Bring sandals or slides for walking off the mat.' },
  { title: 'A water bottle', note: "You'll want it." },
  { title: 'A mouthguard', note: 'Optional, but a good idea once you start rolling.' },
  { title: 'Short nails, no jewelry', note: 'Trim your nails, take off rings and earrings, and tie back long hair. Wash your gear after every class.' },
];

const reasons = [
  { title: "It's a good workout", note: "You're solving a problem with a partner, so the hour goes quickly. Expect to sweat." },
  { title: 'It works for self-defense', note: 'You practise against a partner who is resisting, so you learn what works, including against someone bigger.' },
  { title: 'You learn to stay calm', note: 'Being stuck under someone and working your way out teaches you to breathe and think under pressure.' },
  { title: "There's always more to learn", note: 'It suits any age and fitness level, and you can see yourself improve from week to week.' },
  { title: 'You train with the same people', note: 'Partners help each other get better, so you get to know people quickly.' },
];

const group = 'new-to-bjj';
---

<Base
  title="New to BJJ?"
  description={`New to jiu jitsu? What to wear, what a class looks like and how your free first week works at ${settings.name}.`}
  campaign={campaign}
  currentPath="/new-here"
>
  <!-- Hero: title and buttons, then the topics as dropdowns -->
  <section aria-labelledby="new-h" class="wrap flex flex-col gap-10 pb-12 pt-12 md:grid md:grid-cols-12 md:items-start md:gap-x-8 md:pb-24 md:pt-24">
    <div class="flex flex-col gap-4 md:col-span-5 md:gap-6">
      <span class="text-label uppercase text-signal-text">First class</span>
      <h1 id="new-h" class="display text-display-detail text-ink" style={fitStyle('New to BJJ?')} data-motion="title">New to<br />BJJ?</h1>
      <p class="max-w-82 text-body text-ink md:max-w-120 md:text-body-l">Everything you need to know before your first class.</p>
      <div class="flex flex-col gap-2 pt-2 md:flex-row md:flex-wrap md:gap-3">
        <Button href={signup('hero')} variant="primary" arrow class="w-full justify-center md:w-auto">Start your free week</Button>
        <Button href="/schedule" class="w-full justify-center md:w-auto">View schedule</Button>
      </div>
    </div>

    <div class="flex flex-col gap-6 md:col-span-6 md:col-start-7 md:pt-4">
      <div class="border-t border-line">
        <Disclosure title="How your free week works" group={group}>
          <ul class="flex flex-col gap-4">
            {
              firstWeek.map((item) => (
                <li class="flex flex-col gap-1">
                  <span class="font-medium text-ink">{item.title}</span>
                  <span>{item.note}</span>
                </li>
              ))
            }
          </ul>
          {
            starters.length > 0 && (
              <p class="mt-5">
                Not sure which class to try first? Start with{' '}
                {starters.map((p, i) => (
                  <>
                    {i > 0 && ' or '}
                    <a href={`/programs/${p.id}`} class="link">
                      {p.data.shortName ?? p.data.name}
                    </a>
                  </>
                ))}
                .
              </p>
            )
          }
        </Disclosure>

        <Disclosure title="What is BJJ?" group={group}>
          <div class="[&_p+p]:mt-4">
            <p>
              Jiu jitsu is a grappling martial art. Instead of punching and kicking, you learn to control another person using position, leverage
              and timing, mostly on the ground. A round ends when someone taps out of a joint lock or choke, or simply when time runs out.
            </p>
            <p>
              No-Gi means we train in athletic clothes rather than the traditional heavy uniform. It's faster, closer to how a real situation looks,
              and you don't need to buy anything special to start.
            </p>
          </div>
        </Disclosure>

        <Disclosure title="How a class runs" group={group}>
          <ol class="flex flex-col gap-4">
            {
              classParts.map((part, i) => (
                <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-2">
                  <span class="w-7 font-mono text-time text-ink-muted md:w-10">{padIndex(i + 1)}</span>
                  <span class="flex flex-col gap-1">
                    <span class="font-medium text-ink">{part.title}</span>
                    <span>{part.note}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </Disclosure>

        <Disclosure title="What to wear" group={group}>
          <p class="mb-5 text-ink">Regular gym clothes work. Kids wear the same.</p>
          <ul class="flex flex-col gap-4">
            {
              wear.map((item) => (
                <li class="flex flex-col gap-1">
                  <span class="font-medium text-ink">{item.title}</span>
                  <span>{item.note}</span>
                </li>
              ))
            }
          </ul>
        </Disclosure>

        <Disclosure title="Why people stick with it" group={group}>
          <ul class="flex flex-col gap-4">
            {
              reasons.map((reason) => (
                <li class="flex flex-col gap-1">
                  <span class="font-medium text-ink">{reason.title}</span>
                  <span>{reason.note}</span>
                </li>
              ))
            }
          </ul>
        </Disclosure>

        {
          youth && (
            <Disclosure title="For parents" group={group}>
              <div class="flex flex-col gap-4">
                <p class="font-medium text-ink">{youth.data.name}</p>
                <div class="flex flex-wrap gap-2">
                  {youth.data.tags.map((tag) => (
                    <Tag>{tag}</Tag>
                  ))}
                </div>
                <p>{youth.data.summary}</p>
                <p class="font-mono text-time text-ink">{summaryFor(youth, schedule)}</p>
                <a href={`/programs/${youth.id}`} class="link self-start">
                  About {youth.data.shortName ?? youth.data.name} →
                </a>
              </div>
            </Disclosure>
          )
        }
      </div>

      <p class="text-body-sm text-ink-muted">
        Questions? Call <a href={telHref(settings.phone)} class="font-mono text-ink no-underline hover:text-signal-text">{settings.phone}</a> or{' '}
        <a href="/contact" class="link">send us a message</a>.
      </p>
    </div>
  </section>

  <!-- Facts -->
  <section aria-label="The basics" class="wrap pb-12 md:pb-18">
    <FactList facts={facts} />
  </section>

  <FinalCta variant="photo" image={welcomePhoto} alt="A coach welcoming a new student at the edge of the mat" position="50% 28%" href={signup('final-cta')}>
    Your first<br />class is<br />on us.
  </FinalCta>
</Base>
