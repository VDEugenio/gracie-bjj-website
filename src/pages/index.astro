---
/**
 * Home page, built from design/mockups/html/home-{phone,desktop}.html.
 * Sections: hero, "New here?", marquee, programs, today at the gym, coaches,
 * pricing, visit us, final CTA. Everything with a time or a price comes from
 * the content collections.
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import CoachCard from '@/components/CoachCard.astro';
import FinalCta from '@/components/FinalCta.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import Marquee from '@/components/Marquee.astro';
import Photo from '@/components/Photo.astro';
import PhotoBlock from '@/components/PhotoBlock.astro';
import PricingCard from '@/components/PricingCard.astro';
import PricingDropIns from '@/components/PricingDropIns.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import ScheduleDay from '@/components/ScheduleDay.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Steps from '@/components/Steps.astro';
import { getHomeCoaches, getPricing, getPrograms, getSchedule, getSettings } from '@/lib/content';
import { todaySentence } from '@/lib/copy';
import { telHref } from '@/lib/format';
import { gymdeskUrl } from '@/lib/gymdesk';
import { directionsUrl } from '@/lib/maps';
import { groupByDay, summaryFor } from '@/lib/schedule';
import heroPhoto from '@/assets/sections/hero-arm-lock-mirrored.jpg';
import welcomePhoto from '@/assets/sections/welcome.jpg';
import teamPhoto from '@/assets/sections/team-group-photo.jpg';

const campaign = 'home';
const [settings, programs, schedule, coaches, pricing] = await Promise.all([
  getSettings(),
  getPrograms(),
  getSchedule(),
  getHomeCoaches(),
  getPricing(),
]);
const signup = (placement: Parameters<typeof gymdeskUrl>[2]) => gymdeskUrl(settings.gymdesk.signupUrl, campaign, placement);
const { address } = settings;

const days = groupByDay(schedule, programs);
const monday = days[0]!;
// One panel per day plus Sunday; the today script shows the right one. Monday shows without JavaScript.
const panels = [
  ...days.map((day) => ({ key: day.key, label: day.label, sentence: todaySentence(day), card: day })),
  { key: 'sunday', label: 'Sunday', sentence: "No classes today. Here's Monday.", card: monday },
];

const plans = pricing.filter((p) => p.data.period === 'month' || p.data.period === 'free');
const dropIns = pricing.filter((p) => p.data.period === 'day-pass' || p.data.period === '10-pass');

const newHere = [
  { title: 'No experience needed', note: 'Every class has first-timers. Coaches walk you through everything.' },
  { title: 'No gi needed — rash guard and shorts', note: "Wear what you'd wear to any gym. We train No-Gi only." },
  { title: 'Your first week is free', note: 'Try any class for seven days before you decide.' },
];
---

<Base
  title={settings.name}
  description={`No-Gi jiu jitsu and MMA in ${address.neighborhood ?? address.city}, ${address.city}. Adults and kids, all levels. First week free.`}
  campaign={campaign}
  currentPath="/"
>
  <!-- Hero -->
  <section id="top" class="relative h-154 overflow-hidden bg-surface-raised md:h-205 md:bg-surface" aria-labelledby="hero-h">
    <div class="absolute inset-0 md:left-[46%]" data-motion="hero-photo">
      <Photo
        image={heroPhoto}
        alt="Two No-Gi athletes working an arm lock on the mats"
        priority
        sizes="(min-width: 768px) 54vw, 100vw"
        class="object-[50%_30%] md:object-[50%_45%]"
      />
      <div class="absolute inset-0 scrim-bottom md:hidden" aria-hidden="true"></div>
      <div class="absolute inset-0 hidden scrim-left md:block" aria-hidden="true"></div>
      <div class="absolute inset-0 hidden scrim-up md:block" aria-hidden="true"></div>
    </div>
    <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 px-4 pb-5 md:bottom-24 md:left-20 md:right-auto md:w-245 md:gap-8 md:px-0 md:pb-0">
      <h1 id="hero-h" class="display text-display-xl text-ink" data-motion="hero-title">No-Gi<br />jiu jitsu<br />and MMA.</h1>
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:gap-8">
        <p class="max-w-82 text-body text-ink md:w-120 md:max-w-none md:shrink-0 md:text-body-l">
          {address.neighborhood ?? address.city}, {address.city}. Adults and kids, all levels. First week free.
        </p>
        <div class="hidden items-center gap-3 md:flex" data-motion="hero-cta">
          <Button href={signup('hero')} variant="primary" arrow>Start your free week</Button>
          <Button href="/schedule">View schedule</Button>
        </div>
      </div>
    </div>
    <span class="absolute bottom-10 right-20 hidden font-mono text-time-sm text-ink-muted md:block">
      {address.street.replace(', ', ' · ')}{address.neighborhood && ` · ${address.neighborhood}`}
    </span>
  </section>
  <div class="flex flex-col gap-2 bg-surface px-4 pb-6 pt-4 md:hidden" data-motion="hero-cta">
    <Button href={signup('hero')} variant="primary" arrow full>Start your free week</Button>
    <Button href="/schedule" full>View schedule</Button>
  </div>

  <!-- New here? -->
  <section aria-labelledby="newhere-h" class="border-t border-line bg-surface-raised">
    <div class="md:wrap md:grid md:grid-cols-12 md:items-start md:gap-x-8 md:py-24">
      <PhotoBlock
        image={welcomePhoto}
        alt="A coach welcoming a new student at the edge of the mat"
        position="50% 28%"
        scrim="up"
        scrimClass="md:hidden"
        raised
        class="h-75 md:col-span-4 md:h-140"
        sizes="(min-width: 768px) 33vw, 100vw"
      />
      <div class="flex flex-col gap-6 px-4 pb-12 pt-2 md:col-span-7 md:col-start-6 md:gap-12 md:p-0">
        <SectionHeading eyebrow="First class" eyebrowTone="signal" size="l" id="newhere-h">New here?</SectionHeading>
        <Steps steps={newHere} />
      </div>
    </div>
  </section>

  <Marquee items={programs.map((p) => p.data.shortName ?? p.data.name)} />

  <!-- Programs -->
  <section id="programs" aria-labelledby="programs-h" class="wrap flex flex-col gap-8 py-16 md:gap-12 md:py-24">
    <div class="md:grid md:grid-cols-12 md:items-end md:gap-x-8">
      <SectionHeading eyebrow="Programs" size="l" id="programs-h" class="md:col-span-6">
        Find your class
        <p slot="intro" class="mt-2 max-w-80 text-body text-ink-muted md:hidden">Not sure where to start? Fundamentals or Mixed Level.</p>
      </SectionHeading>
      <p class="hidden text-body text-ink-muted md:col-span-3 md:col-start-8 md:block">Not sure where to start? Fundamentals or Mixed Level.</p>
      <div class="hidden md:col-span-2 md:col-start-11 md:flex md:justify-end">
        <Button href="/schedule">View schedule</Button>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {programs.map((p, i) => <ProgramCard program={p} index={i + 1} summary={summaryFor(p, schedule)} />)}
    </div>
  </section>

  <!-- Today at the gym -->
  <section aria-label="Today at the gym" class="border-t border-line bg-surface-raised md:border-b">
    <div class="wrap flex flex-col gap-6 pb-16 pt-12 md:grid md:grid-cols-12 md:items-start md:gap-x-8 md:py-24">
      {
        panels.map((panel, i) => (
          <div class="contents" data-today-panel={panel.key} hidden={i !== 0}>
            <div class="flex flex-col gap-6 md:col-span-5 md:pr-8">
              <div class="flex flex-col gap-2 md:gap-3">
                <span class="text-label uppercase text-ink-muted" data-today-eyebrow>
                  This week at the gym
                </span>
                <h2 class="display text-display-l text-ink">{panel.label}</h2>
              </div>
              <p class="hidden max-w-95 text-body text-ink-muted md:block">{panel.sentence}</p>
              <a href="/schedule" class="link hidden self-start md:inline">
                See the full schedule →
              </a>
            </div>
            <ScheduleDay day={panel.card} variant="home" headingLevel={3} id={`today-${panel.key}`} class="md:col-span-7" />
            <a href="/schedule" class="link self-start md:hidden">
              See the full schedule →
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Coaches -->
  <section id="coaches" aria-labelledby="coaches-h" class="wrap flex flex-col gap-8 py-16 md:gap-12 md:py-24">
    <div class="md:grid md:grid-cols-12 md:items-end md:gap-x-8">
      <SectionHeading eyebrow="Coaches" size="l" id="coaches-h" class="md:col-span-6">Meet your coaches</SectionHeading>
      <div class="hidden md:col-span-2 md:col-start-11 md:flex md:justify-end">
        <Button href="/coaches">Meet the coaches</Button>
      </div>
    </div>
    <div class="tilt-stage grid grid-cols-2 gap-4 md:grid-cols-4">
      {coaches.map((c, i) => <CoachCard coach={c} index={i + 1} variant="compact" headingLevel={3} />)}
    </div>
    <Button href="/coaches" class="self-start md:hidden">Meet the coaches</Button>
  </section>

  <!-- Pricing -->
  <section id="pricing" aria-labelledby="pricing-h" class="border-t border-line bg-surface-raised md:border-b">
    <div class="wrap flex flex-col gap-8 py-16 md:gap-12 md:py-24">
      <div class="md:grid md:grid-cols-12 md:items-end md:gap-x-8">
        <SectionHeading eyebrow="Pricing" size="l" id="pricing-h" class="md:col-span-6">
          Simple pricing
          <p slot="intro" class="mt-2 max-w-80 text-body text-ink-muted md:hidden">One rate for adults, one for kids. Open mat included.</p>
        </SectionHeading>
        <p class="hidden text-body text-ink-muted md:col-span-4 md:col-start-8 md:block">
          One rate for adults, one for kids. Open mat included with both.
        </p>
      </div>
      <div class="flex flex-col gap-4">
        <div class="grid gap-4 md:grid-cols-3">
          {plans.map((plan) => <PricingCard plan={plan} href={signup('pricing')} />)}
        </div>
        <PricingDropIns plans={dropIns} href={signup('pricing')} />
      </div>
    </div>
  </section>

  <!-- Visit us -->
  <section
    id="contact"
    aria-labelledby="visit-h"
    class="wrap flex flex-col gap-6 py-16 md:grid md:grid-cols-12 md:grid-rows-[auto_1fr] md:items-start md:gap-x-8 md:py-24"
  >
    <SectionHeading eyebrow="Location" size="l" id="visit-h" class="md:col-span-5">Visit us</SectionHeading>
    <MapEmbed settings={settings} class="order-1 h-60 md:order-none md:col-span-7 md:col-start-6 md:row-span-2 md:row-start-1 md:h-130" />
    <div class="order-2 flex flex-col gap-6 md:order-none md:col-span-5 md:row-start-2 md:pr-8">
      <address class="flex flex-col gap-1 text-body leading-normal md:text-body-l">
        <span class="font-semibold">{settings.name}</span>
        <span>
          {address.street}<br />
          {address.city}, {address.state} {address.zip}{address.neighborhood && ` · ${address.neighborhood}`}
        </span>
        <a href={telHref(settings.phone)} class="mt-1 self-start font-mono text-time-l text-signal-text no-underline">{settings.phone}</a>
      </address>
      {
        settings.parkingNote ? (
          <p class="max-w-105 text-body-sm leading-normal text-ink-muted">{settings.parkingNote}</p>
        ) : (
          <p class="max-w-105 border border-dashed border-line-strong p-4 text-body-sm leading-normal text-ink-muted">
            [Parking and entrance note for Suite 130 — where to park, which door to use.]
          </p>
        )
      }
      <Button href={directionsUrl(settings)} class="self-start">Get directions</Button>
    </div>
  </section>

  <FinalCta variant="photo" image={teamPhoto} alt="The whole team on the mats after class" position="50% 35%" href={signup('final-cta')}>
    Your first<br />class is<br />on us.
  </FinalCta>
</Base>
