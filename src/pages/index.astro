---
/**
 * Home page placeholder until phase 4 builds the real one from the mockup.
 * Keeps the build green and exercises the layout (promo, header, footer).
 */
import Base from '@/layouts/Base.astro';
---

<Base
  title="Relson Gracie Jiu-Jitsu of Charleston"
  description="No-Gi jiu jitsu and MMA in West Ashley, Charleston. Adults and kids, all levels. First week free."
  campaign="home"
>
  <section class="wrap py-16 md:py-24">
    <p class="text-label uppercase text-ink-muted">Home</p>
    <h1 class="display text-display-xl mt-3">No-Gi<br />jiu jitsu<br />and MMA.</h1>
    <p class="mt-8 max-w-120 text-body-l">West Ashley, Charleston. Adults and kids, all levels. First week free.</p>
  </section>
</Base>
