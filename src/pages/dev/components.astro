---
/**
 * TEMPORARY component gallery with real content, for comparing against the
 * mockups at 390px and 1440px. Not linked from anywhere, noindex, and removed
 * before launch (phase 6).
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Chip from '@/components/Chip.astro';
import CoachCard from '@/components/CoachCard.astro';
import ContactForm from '@/components/ContactForm.astro';
import ContactInfo from '@/components/ContactInfo.astro';
import FactList from '@/components/FactList.astro';
import FinalCta from '@/components/FinalCta.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import Marquee from '@/components/Marquee.astro';
import PhotoBlock from '@/components/PhotoBlock.astro';
import PriceList from '@/components/PriceList.astro';
import PricingCard from '@/components/PricingCard.astro';
import PricingDropIns from '@/components/PricingDropIns.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import ProgramLinkList from '@/components/ProgramLinkList.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import ScheduleDay from '@/components/ScheduleDay.astro';
import ScheduleFilter from '@/components/ScheduleFilter.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Steps from '@/components/Steps.astro';
import Tag from '@/components/Tag.astro';
import { getCoaches, getHomeCoaches, getPricing, getPrograms, getSchedule, getSettings } from '@/lib/content';
import { gymdeskUrl } from '@/lib/gymdesk';
import { directionsUrl } from '@/lib/maps';
import { groupByDay, summaryFor, timeRows, whenFact } from '@/lib/schedule';
import heroPhoto from '@/assets/sections/hero-arm-lock-mirrored.jpg';
import teamPhoto from '@/assets/sections/team-group-photo.jpg';
import welcomePhoto from '@/assets/sections/welcome.jpg';

const campaign = 'dev-components';
const [settings, programs, schedule, coaches, homeCoaches, pricing] = await Promise.all([
  getSettings(),
  getPrograms(),
  getSchedule(),
  getCoaches(),
  getHomeCoaches(),
  getPricing(),
]);

const signup = (placement: Parameters<typeof gymdeskUrl>[2]) => gymdeskUrl(settings.gymdesk.signupUrl, campaign, placement);
const days = groupByDay(schedule, programs);
const monday = days[0]!;
const fundamentals = programs.find((p) => p.id === 'fundamentals') ?? programs[0]!;
const plans = pricing.filter((p) => p.data.period === 'month' || p.data.period === 'free');
const dropIns = pricing.filter((p) => p.data.period === 'day-pass' || p.data.period === '10-pass');
const otherPrograms = programs
  .filter((p) => p.id !== fundamentals.id)
  .slice(0, 3)
  .map((p) => ({ name: p.data.shortName ?? p.data.name, href: `/programs/${p.id}`, summary: summaryFor(p, schedule) }));

const newHere = [
  { title: 'No experience needed', note: 'Every class has first-timers. Coaches walk you through everything.' },
  { title: 'No gi needed — rash guard and shorts', note: "Wear what you'd wear to any gym. We train No-Gi only." },
  { title: 'Your first week is free', note: 'Try any class for seven days before you decide.' },
];
const firstClass = [
  { title: 'Start your free week online', note: 'It takes a couple of minutes through Gymdesk.' },
  { title: 'Wear a rash guard and shorts', note: 'No gi needed. We train No-Gi only.' },
  { title: 'Come to a 6 PM class', note: `Monday or Wednesday, ${settings.address.street}.` },
];
const facts = [
  { label: 'When', value: whenFact(schedule, fundamentals.id), mono: true },
  { label: 'Length', value: `${schedule.find((c) => c.data.program.id === fundamentals.id)?.data.durationMin ?? 60} min`, mono: true },
  { label: 'Who', value: fundamentals.data.who ?? 'Adults' },
  { label: 'Cost', value: fundamentals.data.cost },
];
---

<Base
  title="Component gallery"
  description="Temporary component gallery for comparing the build against the mockups."
  campaign={campaign}
  noindex
>
  <div class="wrap py-8">
    <p class="text-label uppercase text-signal-text">Dev · components</p>
    <h1 class="display text-display-l mt-3">Component gallery</h1>
    <p class="mt-4 max-w-130 text-body-l text-ink-muted">
      Every component with real content. The promo banner, header, mobile menu and footer are the ones around this page.
    </p>
  </div>

  <!-- Type scale -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">Type scale</h2>
    <div class="flex flex-col gap-8 overflow-hidden">
      <p class="display text-display-page">Programs</p>
      <p class="display text-display-xl">No-Gi<br />jiu jitsu</p>
      <p class="display text-display-detail">Fundamentals</p>
      <p class="display text-display-l">Find your class</p>
      <p class="display text-display-m">Mixed Level<br />Jiu Jitsu</p>
      <p class="display text-display-name">Relson<br />Gracie</p>
      <p class="display text-heading">Youth Jiu Jitsu</p>
      <p class="display text-heading-sm">Adult No-Gi and MMA</p>
      <p class="display-wide text-marquee">Mixed Level</p>
      <p class="title text-title">Monday</p>
      <p class="text-lead">No experience needed</p>
      <p class="text-body-l">Hero and section intros use body-l.</p>
      <p class="text-body">Default body copy and card descriptions.</p>
      <p class="text-body-sm text-ink-muted">Supporting copy at body-sm.</p>
      <p class="text-caption text-ink-muted">Captions and footnotes.</p>
      <p class="text-label uppercase text-ink-muted">All levels</p>
      <p class="font-mono text-time">6:00 PM · Fundamentals</p>
      <p class="font-mono text-price-l">$0</p>
    </div>
  </section>

  <!-- Buttons, tags, chips -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">Button · Tag · Chip</h2>
    <div class="flex flex-wrap items-center gap-3">
      <Button href={signup('section-cta')} variant="primary" arrow>Start your free week</Button>
      <Button href="/schedule">View schedule</Button>
      <Button href={signup('header')} size="sm">Start your free week</Button>
      <Button href="/coaches" size="sm">Meet the coaches</Button>
      <Button type="button">Send message</Button>
    </div>
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <Tag variant="signal">Start here</Tag>
      <Tag variant="signal">This month</Tag>
      <Tag>All levels</Tag>
      <Tag>Beginners</Tag>
      <Tag>Kids</Tag>
      <Tag>[Ages TBD]</Tag>
      <Tag href="#p-mixed-level">Mixed Level</Tag>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      <Chip label="All" value="all" pressed />
      <Chip label="Adults" value="adults" />
      <Chip label="Kids" value="kids" />
      <Chip label="Beginners" value="beginners" />
      <Chip label="MMA" value="program:mma" />
    </div>
  </section>

  <!-- Section headings -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">SectionHeading</h2>
    <div class="flex flex-col gap-12">
      <SectionHeading eyebrow="Programs" size="l" id="dev-h-programs">
        Find your class
        <p slot="intro" class="mt-2 max-w-80 text-body text-ink-muted">Not sure where to start? Fundamentals or Mixed Level.</p>
      </SectionHeading>
      <SectionHeading eyebrow="First class" eyebrowTone="signal" size="l" id="dev-h-newhere">New here?</SectionHeading>
      <SectionHeading eyebrow="Schedule · Monday to Saturday" level={3} size="page" id="dev-h-page">Class<br />schedule</SectionHeading>
    </div>
  </section>

  <!-- Photo block (hero-style) -->
  <section class="border-t border-line">
    <h2 class="wrap py-6 text-label uppercase text-signal-text">PhotoBlock · hero crop with scrim</h2>
    <PhotoBlock image={heroPhoto} alt="Two No-Gi athletes working an arm lock on the mats" position="50% 30%" scrim="bottom" class="h-154 md:h-205" sizes="100vw">
      <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 px-4 pb-5 md:left-20 md:right-auto md:w-245 md:gap-8 md:px-0 md:pb-24">
        <p class="display text-display-xl text-ink">No-Gi<br />jiu jitsu<br />and MMA.</p>
        <p class="max-w-82 text-body text-ink md:max-w-120 md:text-body-l">West Ashley, Charleston. Adults and kids, all levels. First week free.</p>
      </div>
    </PhotoBlock>
    <div class="flex flex-col gap-2 px-4 pb-6 pt-4 md:hidden">
      <Button href={signup('hero')} variant="primary" arrow full>Start your free week</Button>
      <Button href="/schedule" full>View schedule</Button>
    </div>
  </section>

  <!-- Marquee -->
  <section class="border-t border-line">
    <h2 class="wrap py-6 text-label uppercase text-signal-text">Marquee</h2>
    <Marquee items={programs.map((p) => p.data.shortName ?? p.data.name)} />
  </section>

  <!-- Program cards -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">ProgramCard</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {programs.map((p, i) => <ProgramCard program={p} index={i + 1} summary={summaryFor(p, schedule)} />)}
    </div>
  </section>

  <!-- Program rows -->
  <section class="border-t border-line">
    <h2 class="wrap py-6 text-label uppercase text-signal-text">ProgramRow · ProgramTimes</h2>
    <div class="md:wrap">
      {programs.map((p, i) => <ProgramRow program={p} index={i + 1} rows={timeRows(schedule, p.id)} last={i === programs.length - 1} />)}
    </div>
  </section>

  <!-- Schedule -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">ScheduleFilter · ScheduleDay</h2>
    <ScheduleFilter programIds={programs.map((p) => p.id)} class="mb-6" />
    <div class="grid gap-4 md:grid-cols-3">
      {days.map((day) => <ScheduleDay day={day} today={day.key === 'monday'} note={day.key === 'saturday' ? settings.scheduleNote : undefined} />)}
    </div>
    <h3 class="mb-4 mt-12 text-label uppercase text-signal-text">ScheduleDay · home variant</h3>
    <div class="md:grid md:grid-cols-12 md:gap-x-8">
      <ScheduleDay day={monday} today variant="home" headingLevel={3} class="md:col-span-7 md:col-start-6" />
    </div>
  </section>

  <!-- Light theme -->
  <section data-theme="light" class="border-t border-line bg-surface text-ink">
    <div class="wrap py-12">
      <h2 class="mb-6 text-label uppercase text-signal-text">Light theme · ScheduleDay · ProgramLinkList · Steps cards</h2>
      <div class="md:grid md:grid-cols-12 md:gap-x-8">
        <div class="flex flex-col gap-5 md:col-span-6">
          <SectionHeading eyebrow="This week" size="m" id="dev-h-week">Fundamentals<br />classes</SectionHeading>
          <div class="flex flex-col gap-4 md:grid md:grid-cols-2">
            <ScheduleDay day={{ ...monday, classes: monday.classes.filter((c) => c.program.id === 'fundamentals') }} today headingLevel={3} showTags={false} />
            <ScheduleDay day={{ ...days[2]!, classes: days[2]!.classes.filter((c) => c.program.id === 'fundamentals') }} headingLevel={3} showTags={false} />
          </div>
          <a href="/schedule" class="link self-start">See the full schedule →</a>
        </div>
        <div class="mt-12 flex flex-col gap-5 md:col-span-5 md:col-start-8 md:mt-0">
          <span class="text-label uppercase text-ink-muted">Other programs</span>
          <ProgramLinkList items={otherPrograms} />
          <a href="/programs" class="link self-start">All programs →</a>
        </div>
      </div>
      <div class="mt-12">
        <SectionHeading eyebrow="New here?" size="l" id="dev-h-first" class="mb-6 md:mb-12">Your first class</SectionHeading>
        <Steps steps={firstClass} variant="cards" />
      </div>
    </div>
  </section>

  <!-- Coach cards -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">CoachCard · full</h2>
    <div class="grid gap-4 md:grid-cols-3" style="perspective: 900px">
      {coaches.map((c, i) => <CoachCard coach={c} index={i + 1} />)}
    </div>
    <h3 class="mb-4 mt-12 text-label uppercase text-signal-text">CoachCard · compact (home)</h3>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {homeCoaches.map((c, i) => <CoachCard coach={c} index={i + 1} variant="compact" headingLevel={3} />)}
    </div>
  </section>

  <!-- Pricing -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">PricingCard · PricingDropIns · PriceList</h2>
    <div class="flex flex-col gap-4">
      <div class="grid gap-4 md:grid-cols-3">
        {plans.map((plan) => <PricingCard plan={plan} href={signup('pricing')} />)}
      </div>
      <PricingDropIns plans={dropIns} href={signup('pricing')} />
    </div>
    <div class="mt-12 md:max-w-130">
      <PriceList
        rows={[
          ...plans.filter((p) => p.data.period === 'month').map((p) => ({ label: p.data.name, price: `${p.data.price}/mo` })),
          { label: 'First week', price: 'Free' },
        ]}
      />
    </div>
  </section>

  <!-- Steps numbered + facts -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">Steps · numbered</h2>
    <Steps steps={newHere} />
    <h3 class="mb-6 mt-12 text-label uppercase text-signal-text">FactList</h3>
    <FactList facts={facts} />
  </section>

  <!-- Welcome strip photo -->
  <section class="border-t border-line bg-surface-raised">
    <h2 class="wrap py-6 text-label uppercase text-signal-text">PhotoBlock · section photo (raised band)</h2>
    <div class="wrap pb-12 md:grid md:grid-cols-12 md:gap-x-8">
      <PhotoBlock image={welcomePhoto} alt="A coach welcoming a new student at the edge of the mat" position="50% 25%" scrim="up" raised class="h-75 md:col-span-4 md:h-140" sizes="(min-width: 768px) 33vw, 100vw" />
    </div>
  </section>

  <!-- Final CTAs -->
  <section class="border-t border-line">
    <h2 class="wrap py-6 text-label uppercase text-signal-text">FinalCta · photo</h2>
    <FinalCta variant="photo" image={teamPhoto} alt="The whole team on the mats after class" position="50% 35%" href={signup('final-cta')} id="dev-cta-photo">
      Your first<br />class is<br />on us.
    </FinalCta>
    <h2 class="wrap py-6 text-label uppercase text-signal-text">FinalCta · band (raised, with body)</h2>
    <FinalCta variant="band" size="l" body="Any class, Monday to Saturday." href={signup('final-cta')} id="dev-cta-band">
      Your first week<br />is free.
    </FinalCta>
    <h2 class="wrap py-6 text-label uppercase text-signal-text">FinalCta · band (surface, secondary)</h2>
    <FinalCta variant="band" tone="surface" href={signup('final-cta')} secondary={{ href: '/schedule', label: 'View schedule' }} id="dev-cta-surface">
      Your first class<br />is on us.
    </FinalCta>
  </section>

  <!-- Contact -->
  <section class="wrap border-t border-line py-12">
    <h2 class="mb-6 text-label uppercase text-signal-text">ContactInfo · MapEmbed · ContactForm</h2>
    <div class="md:grid md:grid-cols-12 md:gap-x-8">
      <div class="flex flex-col gap-6 md:col-span-5">
        <ContactInfo settings={settings} schedule={schedule} />
        <div class="border border-dashed border-line-strong p-4 text-body-sm leading-normal text-ink-muted">
          {settings.parkingNote ?? '[Parking and entrance note for Suite 130 — where to park, which door to use.]'}
        </div>
        <div class="grid grid-cols-2 gap-2 md:flex md:gap-3">
          <Button href={directionsUrl(settings)} class="justify-center px-3 md:px-6">Get directions</Button>
          <Button href={`tel:${settings.phone.replace(/\D/g, '')}`} class="justify-center px-3 md:px-6">Call</Button>
        </div>
      </div>
      <MapEmbed settings={settings} class="mt-8 h-65 md:col-span-6 md:col-start-7 md:mt-0 md:h-190" />
    </div>
    <div class="mt-12 md:max-w-150">
      <ContactForm />
    </div>
  </section>
</Base>
