# Copy to .env (git-ignored). Never commit real values.

# Production origin, no trailing slash. Used for canonical URLs, Open Graph tags and the sitemap.
SITE_URL=https://example.com

# Keystatic storage mode: "local" (edit files in dev only) or "cloud" (Keystatic Cloud, works in production).
# TODO(mike): switch to "cloud" once the Keystatic Cloud project exists.
KEYSTATIC_STORAGE=local

# Keystatic Cloud project in the form "team/project". Required when KEYSTATIC_STORAGE=cloud.
# Prefixed PUBLIC_ because the admin UI (a client bundle) reads it.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=
